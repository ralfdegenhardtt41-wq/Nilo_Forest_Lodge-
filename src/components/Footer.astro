---
import { NAV, SITE } from '../site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap cols">
    <div>
      <h3>{SITE.name}</h3>
      <p>Private forest house on the boundary of the Nilo Nature Forest Reserve, East Usambara Mountains, Muheza District, Tanga Region, Tanzania.</p>
    </div>
    <div>
      <h3>Explore</h3>
      <ul>{NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
    </div>
    <div>
      <h3>Bookings &amp; enquiries</h3>
      <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a><br />Tel <a href={SITE.phoneHref}>{SITE.phone}</a></p>
      <p>{SITE.role}</p>
      <p>Reservations are handled from Switzerland. All rates are quoted in USD.</p>
      <p><a href="/tour-operators/">Information for tour operators</a></p>
    </div>
  </div>
  <div class="wrap bottom">
    <p>&copy; {year} {SITE.name} · Operated by {SITE.operator}, {SITE.operatorAddress}</p>
  </div>
</footer>
<style>
  .site-footer { background: var(--green-dark); color: var(--sand-light); padding: 3.5rem 0 1.5rem; font-size: .92rem; }
  .cols { display: grid; gap: 2.5rem; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  h3 { color: var(--sand); font-size: 1.1rem; }
  ul { list-style: none; padding: 0; margin: 0; }
  li { margin-bottom: .35rem; }
  a { color: var(--cream); }
  .bottom { border-top: 1px solid rgba(255,255,255,.12); margin-top: 2.5rem; padding-top: 1.25rem; font-size: .8rem; opacity: .8; }
</style>
