---
import { Image } from 'astro:assets';
interface Props { images: { src: ImageMetadata; alt: string }[]; id: string }
const { images, id } = Astro.props;
---
<div class="gallery" id={id}>
  <div class="track" tabindex="0" aria-label="Image gallery, scroll horizontally">
    {images.map((img, i) => (
      <figure>
        <Image src={img.src} alt={img.alt} width={1200} widths={[480, 800, 1200]} sizes="(max-width: 700px) 100vw, 800px" format="webp" quality={78} loading={i === 0 ? 'eager' : 'lazy'} />
      </figure>
    ))}
  </div>
  <div class="controls">
    <button type="button" class="prev" aria-label="Previous image">&#8592;</button>
    <span class="count"><span class="cur">1</span> / {images.length}</span>
    <button type="button" class="next" aria-label="Next image">&#8594;</button>
  </div>
</div>
<style>
  .gallery { position: relative; }
  .track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; border-radius: 6px; aspect-ratio: 4 / 3; background: var(--green-dark); }
  .track::-webkit-scrollbar { display: none; }
  .track figure { flex: 0 0 100%; scroll-snap-align: start; }
  .track img { width: 100%; height: 100%; object-fit: cover; }
  .controls { display: flex; align-items: center; justify-content: center; gap: 1rem; padding: .6rem 0; font-size: .85rem; color: var(--muted); }
  button { background: none; border: 1px solid var(--green); color: var(--green); border-radius: 50%; width: 34px; height: 34px; cursor: pointer; font-size: 1rem; }
  button:hover { background: var(--green); color: var(--cream); }
</style>
<script>
  document.querySelectorAll<HTMLElement>('.gallery').forEach((g) => {
    const track = g.querySelector<HTMLElement>('.track')!;
    const cur = g.querySelector<HTMLElement>('.cur')!;
    const n = track.children.length;
    const idx = () => Math.round(track.scrollLeft / track.clientWidth);
    const go = (i: number) => track.scrollTo({ left: ((i + n) % n) * track.clientWidth, behavior: 'smooth' });
    g.querySelector('.prev')!.addEventListener('click', () => go(idx() - 1));
    g.querySelector('.next')!.addEventListener('click', () => go(idx() + 1));
    track.addEventListener('scroll', () => { cur.textContent = String(idx() + 1); }, { passive: true });
  });
</script>
