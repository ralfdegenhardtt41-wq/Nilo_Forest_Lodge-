---
interface Props { title: string; lead?: string; crumbs?: { href: string; label: string }[] }
const { title, lead, crumbs = [] } = Astro.props;
---
<section class="page-hero">
  <div class="wrap">
    {crumbs.length > 0 && (
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>{crumbs.map((c) => <> › <a href={c.href}>{c.label}</a></>)}
      </nav>
    )}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
  </div>
</section>
